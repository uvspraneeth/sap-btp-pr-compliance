    { "name": "PR_Approver", "description": "PR Compliance - Approver", "role-template-references": ["$XSAPPNAME.Approver"] },
    { "name": "PR_Buyer", "description": "PR Compliance - Buyer", "role-template-references": ["$XSAPPNAME.Buyer"] },

# Copy to deploy/secrets.mtaext (git-ignored), fill in, then:
#   cf deploy mta_archives/pr-compliance_1.0.0.mtar -e deploy/secrets.mtaext
# Never commit the filled-in file.
_schema-version: "3.3"
ID: pr-compliance-secrets
extends: pr-compliance

resources:
  # HMAC key for the signed, single-use Outlook approve/reject links.
  # Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
  - name: pr-secrets
    parameters:
      config:
        tokenSecret: "<96 random hex characters>"

  # SMTP relay (works with a student account: e.g. Brevo free tier or a Gmail app password).
  # Mails still land in the approvers' Outlook inbox.
  - name: pr-mail
    parameters:
      config:
        host: "smtp-relay.brevo.com"
        port: 587
        secure: false
        user: "<smtp login>"
        password: "<smtp password or API key>"
        from: "PR Compliance <approvals@your-domain.example>"
        # --- optional: Microsoft Graph instead of SMTP (needs an Exchange Online licensed mailbox)
        # transport: graph
        # tenantId: "<entra tenant id>"
        # clientId: "<app registration client id>"
        # clientSecret: "<client secret>"
        # sender: "approvals@your-domain.example"
